{
  "id": "com.biostar2.community",
  "version": "1.5.3",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "BioStar 2",
    "nl": "BioStar 2",
    "fr": "BioStar 2"
  },
  "description": {
    "en": "Let every badge and fingerprint at your door start a Flow",
    "nl": "Laat elke badge en vingerafdruk aan je deur een Flow starten",
    "fr": "Chaque badge ou empreinte à votre porte peut lancer un Flow"
  },
  "brandColor": "#0E74BE",
  "category": [
    "security"
  ],
  "permissions": [],
  "images": {
    "small": "assets/images/small.jpg",
    "large": "assets/images/large.jpg",
    "xlarge": "assets/images/xlarge.jpg"
  },
  "author": {
    "name": "LDB Technology",
    "email": "homey@ldbtechnology.be"
  },
  "support": "mailto:support@ldbtechnology.be",
  "source": "https://github.com/LionelDerBoven/com.biostar2.community",
  "bugs": {
    "url": "https://github.com/LionelDerBoven/com.biostar2.community/issues"
  },
  "api": {
    "testConnection": {
      "method": "post",
      "path": "/test"
    },
    "getLogs": {
      "method": "get",
      "path": "/logs"
    },
    "clearLogs": {
      "method": "post",
      "path": "/clear-logs"
    },
    "getStatus": {
      "method": "get",
      "path": "/status"
    },
    "reconnect": {
      "method": "post",
      "path": "/reconnect"
    },
    "getEventTypes": {
      "method": "get",
      "path": "/event-types"
    }
  }
}
