{
  "id": "identification_failed",
  "title": {
    "en": "Identification failed"
  },
  "titleFormatted": {
    "en": "Identification failed at [[device]]"
  },
  "hint": {
    "en": "Triggers when a reader could not identify the person at all, for example an unknown fingerprint, an unrecognised card or an unknown face. Pick a reader to trigger only for that one, or leave it on 'Any reader'. BioStar 2 has no user to report, so only the device, event name and timestamp are available as tags."
  },
  "args": [
    {
      "name": "device",
      "type": "autocomplete",
      "title": {
        "en": "Reader"
      },
      "placeholder": {
        "en": "Any reader"
      }
    }
  ],
  "tokens": [
    {
      "name": "device",
      "type": "string",
      "title": {
        "en": "Device / Door Name"
      },
      "example": "Main Entrance"
    },
    {
      "name": "event_name",
      "type": "string",
      "title": {
        "en": "Event Name"
      },
      "example": "BS2_EVENT_IDENTIFY_FAIL_FINGER"
    },
    {
      "name": "timestamp",
      "type": "string",
      "title": {
        "en": "Timestamp"
      },
      "example": "2026-01-01T12:00:00+00:00"
    }
  ]
}
