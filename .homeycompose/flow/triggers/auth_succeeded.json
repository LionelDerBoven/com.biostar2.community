{
  "id": "auth_succeeded",
  "title": {
    "en": "Authentication succeeded",
    "nl": "Authenticatie geslaagd",
    "fr": "Authentification réussie"
  },
  "titleFormatted": {
    "en": "Authentication succeeded at [[device]]",
    "nl": "Authenticatie geslaagd bij [[device]]",
    "fr": "Authentification réussie à [[device]]"
  },
  "hint": {
    "en": "Triggers when a person is successfully identified or verified at a BioStar 2 reader and access is granted. Pick a reader to trigger only for that one, or leave it on 'Any reader' for all of them. Events without an identified user are discarded for security, so the user tags are always filled in.",
    "nl": "Wordt geactiveerd wanneer een persoon met succes wordt geïdentificeerd of geverifieerd bij een BioStar 2-lezer en toegang krijgt. Kies een lezer om alleen daarvoor te activeren, of laat het op 'Elke lezer' staan voor allemaal. Gebeurtenissen zonder geïdentificeerde gebruiker worden om veiligheidsredenen genegeerd, dus de gebruikerstags zijn altijd ingevuld.",
    "fr": "Se déclenche lorsqu'une personne est identifiée ou vérifiée avec succès à un lecteur BioStar 2 et que l'accès lui est accordé. Choisissez un lecteur pour ne réagir qu'à celui-ci, ou laissez « N'importe quel lecteur » pour tous. Les événements sans utilisateur identifié sont écartés par sécurité, les étiquettes utilisateur sont donc toujours remplies."
  },
  "args": [
    {
      "name": "device",
      "type": "autocomplete",
      "title": {
        "en": "Reader",
        "nl": "Lezer",
        "fr": "Lecteur"
      },
      "placeholder": {
        "en": "Any reader",
        "nl": "Elke lezer",
        "fr": "N'importe quel lecteur"
      }
    }
  ],
  "tokens": [
    {
      "name": "user",
      "type": "string",
      "title": {
        "en": "User Name",
        "nl": "Gebruikersnaam",
        "fr": "Nom d'utilisateur"
      },
      "example": "John Doe"
    },
    {
      "name": "device",
      "type": "string",
      "title": {
        "en": "Device / Door Name",
        "nl": "Apparaat- of deurnaam",
        "fr": "Nom de l'appareil ou de la porte"
      },
      "example": "Main Entrance"
    },
    {
      "name": "user_id",
      "type": "string",
      "title": {
        "en": "User ID",
        "nl": "Gebruikers-ID",
        "fr": "ID utilisateur"
      },
      "example": "101"
    },
    {
      "name": "user_group",
      "type": "string",
      "title": {
        "en": "User Group",
        "nl": "Gebruikersgroep",
        "fr": "Groupe d'utilisateurs"
      },
      "example": "All Users"
    },
    {
      "name": "email",
      "type": "string",
      "title": {
        "en": "Email",
        "nl": "E-mail",
        "fr": "E-mail"
      },
      "example": "user@example.com"
    },
    {
      "name": "title",
      "type": "string",
      "title": {
        "en": "Title",
        "nl": "Functietitel",
        "fr": "Fonction"
      },
      "example": "Staff"
    },
    {
      "name": "department",
      "type": "string",
      "title": {
        "en": "Department",
        "nl": "Afdeling",
        "fr": "Département"
      },
      "example": "Management"
    },
    {
      "name": "telephone",
      "type": "string",
      "title": {
        "en": "Telephone",
        "nl": "Telefoon",
        "fr": "Téléphone"
      },
      "example": "+1234567890"
    },
    {
      "name": "login_id",
      "type": "string",
      "title": {
        "en": "Login ID",
        "nl": "Login-ID",
        "fr": "Identifiant de connexion"
      },
      "example": "johndoe"
    },
    {
      "name": "event_name",
      "type": "string",
      "title": {
        "en": "Event Name",
        "nl": "Gebeurtenisnaam",
        "fr": "Nom de l'événement"
      },
      "example": "BS2_EVENT_IDENTIFY_SUCCESS_FINGER"
    },
    {
      "name": "timestamp",
      "type": "string",
      "title": {
        "en": "Timestamp",
        "nl": "Tijdstempel",
        "fr": "Horodatage"
      },
      "example": "2026-01-01T12:00:00+00:00"
    }
  ]
}
