{
  "id": "event_received",
  "title": {
    "en": "BioStar 2 event received"
  },
  "titleFormatted": {
    "en": "BioStar 2 event received at [[device]]"
  },
  "hint": {
    "en": "Triggers on every BioStar 2 event this app forwards, whatever the outcome. Use the Event Type tag to tell them apart: 'success' (identified and granted access), 'access_denied' (refused at the reader) or 'identification_fail' (person not recognised). Pick a reader to trigger only for that one, or leave it on 'Any reader'. Background events such as door lock and unlock are filtered out and never trigger this card."
  },
  "args": [
    {
      "name": "device",
      "type": "autocomplete",
      "title": {
        "en": "Reader"
      },
      "placeholder": {
        "en": "Any reader"
      }
    }
  ],
  "tokens": [
    {
      "name": "event_type",
      "type": "string",
      "title": {
        "en": "Event Type"
      },
      "example": "success"
    },
    {
      "name": "user",
      "type": "string",
      "title": {
        "en": "User Name"
      },
      "example": "John Doe"
    },
    {
      "name": "device",
      "type": "string",
      "title": {
        "en": "Device / Door Name"
      },
      "example": "Main Entrance"
    },
    {
      "name": "user_id",
      "type": "string",
      "title": {
        "en": "User ID"
      },
      "example": "101"
    },
    {
      "name": "user_group",
      "type": "string",
      "title": {
        "en": "User Group"
      },
      "example": "All Users"
    },
    {
      "name": "email",
      "type": "string",
      "title": {
        "en": "Email"
      },
      "example": "user@example.com"
    },
    {
      "name": "title",
      "type": "string",
      "title": {
        "en": "Title"
      },
      "example": "Staff"
    },
    {
      "name": "department",
      "type": "string",
      "title": {
        "en": "Department"
      },
      "example": "Management"
    },
    {
      "name": "telephone",
      "type": "string",
      "title": {
        "en": "Telephone"
      },
      "example": "+1234567890"
    },
    {
      "name": "login_id",
      "type": "string",
      "title": {
        "en": "Login ID"
      },
      "example": "johndoe"
    },
    {
      "name": "event_name",
      "type": "string",
      "title": {
        "en": "Event Name"
      },
      "example": "BS2_EVENT_IDENTIFY_SUCCESS_FINGER"
    },
    {
      "name": "timestamp",
      "type": "string",
      "title": {
        "en": "Timestamp"
      },
      "example": "2026-01-01T12:00:00+00:00"
    }
  ]
}
