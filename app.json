            "example": "BS2_EVENT_IDENTIFY_SUCCESS_FINGER"
          },
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Timestamp"
            },
            "example": "2026-01-01T12:00:00+00:00"
          }
        ]
      },
      {
        "id": "identification_failed",
        "title": {
          "en": "Identification failed"
        },
        "titleFormatted": {
          "en": "Identification failed at [[device]]"
        },
        "hint": {
          "en": "Triggers when a reader could not identify the person at all, for example an unknown fingerprint, an unrecognised card or an unknown face. Pick a reader to trigger only for that one, or leave it on 'Any reader'. BioStar 2 has no user to report, so only the device, event name and timestamp are available as tags."
        },
        "args": [
          {
            "name": "device",
            "type": "autocomplete",
            "title": {
              "en": "Reader"
            },
            "placeholder": {
              "en": "Any reader"
            }
          }
        ],
        "tokens": [
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device / Door Name"
            },
            "example": "Main Entrance"
          },
          {
            "name": "event_name",
            "type": "string",
            "title": {
              "en": "Event Name"
            },
            "example": "BS2_EVENT_IDENTIFY_FAIL_FINGER"
          },
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Timestamp"
            },
            "example": "2026-01-01T12:00:00+00:00"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "department_is",
        "title": {
          "en": "User belongs to department !{{[department]}}"
        },
        "titleFormatted": {
          "en": "User belongs to department [[department]]"
        },
        "hint": {
          "en": "Checks the department of the person in the event that started this Flow, as set on their BioStar 2 user profile. Matching ignores upper and lower case and accepts a part of the department name. Only works in Flows started by a BioStar 2 trigger card that carries user information; elsewhere it is always false."
        },
        "args": [
          {
            "name": "department",
            "type": "text",
            "placeholder": {
              "en": "IT, Management, Cleaning..."
            }
          }
        ]
      },
      {
        "id": "device_is",
        "title": {
          "en": "Device is !{{[device]}}"
        },
        "titleFormatted": {
          "en": "Device is [[device]]"
        },
        "hint": {
          "en": "Checks which reader or door the event that started this Flow came from. Matching ignores upper and lower case and accepts a part of the name, so 'entrance' also matches 'Main Entrance'. Only works in Flows started by a BioStar 2 trigger card; elsewhere it is always false."
        },
        "args": [
          {
            "name": "device",
            "type": "text",
            "placeholder": {
              "en": "Main Entrance, Side Door..."
            }
          }
        ]
      },
      {
        "id": "is_connected",
        "title": {
          "en": "BioStar 2 connection is online"
        },
        "hint": {
          "en": "Checks whether the app currently has a live connection to the BioStar 2 server and is receiving events. Use it to guard Flows that depend on live access events, or to be warned when the connection drops."
        }
      },
      {
        "id": "user_group_is",
        "title": {
          "en": "User belongs to group !{{[user_group]}}"
        },
        "titleFormatted": {
          "en": "User belongs to group [[user_group]]"
        },
        "hint": {
          "en": "Checks the BioStar 2 user group of the person in the event that started this Flow. Matching ignores upper and lower case and accepts a part of the group name. Only works in Flows started by a BioStar 2 trigger card that carries user information; elsewhere it is always false."
        },
        "args": [
          {
            "name": "user_group",
            "type": "text",
            "placeholder": {
              "en": "All Users, Administrators..."
            }
          }
        ]
      },
      {
        "id": "user_is",
        "title": {
          "en": "User is !{{[user]}}"
        },
        "titleFormatted": {
          "en": "User is [[user]]"
        },
        "hint": {
          "en": "Checks the name of the person in the BioStar 2 event that started this Flow. Matching ignores upper and lower case and accepts a part of the name, so 'john' also matches 'John Doe'. Only works in Flows started by a BioStar 2 trigger card; elsewhere it is always false."
        },
        "args": [
          {
            "name": "user",
            "type": "text",
            "placeholder": {
              "en": "John Doe"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "open_door",
        "title": {
          "en": "Open door"
        },
        "titleFormatted": {
          "en": "Open door [[door]]"
        },
        "hint": {
          "en": "Momentarily releases a door in BioStar 2, the same as pressing Open Door in the BioStar 2 console. The account configured in this app needs the Door control permission in BioStar 2, otherwise the card fails with a permission error."
        },
        "args": [
          {
            "name": "door",
            "type": "autocomplete",
            "title": {
              "en": "Door"
            },
            "placeholder": {
              "en": "Select a door"
            }
          }
        ]
      },
      {
        "id": "reconnect",
        "title": {
          "en": "Force reconnect to BioStar 2"
        },
        "hint": {
          "en": "Drops the current BioStar 2 session and reconnects: the app logs in again, reopens the connection and re-subscribes to the event stream. Handy after a BioStar 2 server restart, although the app already reconnects on its own."
        }
      }
    ]
  }
}