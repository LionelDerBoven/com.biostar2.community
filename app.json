{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.biostar2.community",
  "version": "1.1.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Biostar 2 Community"
  },
  "description": {
    "en": "Connects Suprema BioStar 2 access control events to Homey Pro."
  },
  "brandColor": "#FF5722",
  "category": [
    "security"
  ],
  "permissions": [],
  "images": {
    "small": "assets/images/small.png",
    "large": "assets/images/large.png",
    "xlarge": "assets/images/xlarge.png"
  },
  "author": {
    "name": "LDB Technology",
    "email": "homey@ldbtechnology.be"
  },
  "api": {
    "testConnection": {
      "method": "post",
      "path": "/test"
    },
    "getLogs": {
      "method": "get",
      "path": "/logs"
    },
    "clearLogs": {
      "method": "post",
      "path": "/clear-logs"
    },
    "getStatus": {
      "method": "get",
      "path": "/status"
    },
    "reconnect": {
      "method": "post",
      "path": "/reconnect"
    },
    "getEventTypes": {
      "method": "get",
      "path": "/event-types"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "access_denied",
        "title": {
          "en": "Access denied"
        },
        "titleFormatted": {
          "en": "Access denied at [[device]]"
        },
        "hint": {
          "en": "Triggers when BioStar 2 refuses access at a reader, usually because the person has no permission for that door or is outside their access schedule. Pick a reader to trigger only for that one, or leave it on 'Any reader'. The user tags are filled in when BioStar 2 recognised the person, and read 'N/A' when it did not."
        },
        "args": [
          {
            "name": "device",
            "type": "autocomplete",
            "title": {
              "en": "Reader"
            },
            "placeholder": {
              "en": "Any reader"
            }
          }
        ],
        "tokens": [
          {
            "name": "user",
            "type": "string",
            "title": {
              "en": "User Name"
            },
            "example": "John Doe"
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Device / Door Name"
            },
            "example": "Main Entrance"
          },
          {
            "name": "user_id",
            "type": "string",
            "title": {
              "en": "User ID"
            },
            "example": "101"
          },
          {
            "name": "user_group",
            "type": "string",
            "title": {
              "en": "User Group"
            },
            "example": "All Users"
          },
          {
            "name": "email",
            "type": "string",
            "title": {
              "en": "Email"
            },
            "example": "user@example.com"
          },
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title"
            },
            "example": "Staff"
          },
          {
            "name": "department",
            "type": "string",
            "title": {
              "en": "Department"
            },
            "example": "Management"
          },
          {
            "name": "telephone",
            "type": "string",
            "title": {
              "en": "Telephone"
            },
            "example": "+1234567890"
          },
          {
            "name": "login_id",
            "type": "string",
            "title": {
              "en": "Login ID"
            },
            "example": "johndoe"
          },
          {
            "name": "event_name",
            "type": "string",
            "title": {
              "en": "Event Name"
            },
            "example": "BS2_EVENT_ACCESS_DENIED"
          },
          {
            "name": "timestamp",
            "type": "string",
            "title": {
              "en": "Timestamp"
            },
            "example": "2026-01-01T12:00:00+00:00"
          }
        ]
      },
      {
        "id": "auth_succeeded",
        "title": {
          "en": "Authentication succeeded"
        },
        "titleFormatted": {
          "en": "Authentication succeeded at [[device]]"
        },
        "hint": {
          "en": "Triggers when a person is successfully identified or verified at a BioStar 2 reader and access is granted. Pick a reader to trigger only for that one, or leave it on 'Any reader' for all of them. Events without an identified user are discarded for security, so the user tags are always filled in."
        },
        "args": [
          {
            "name": "device",
            "type": "autocomplete",
            "title": {
              "en": "Reader"
            },
            "placeholder": {
              "en": "Any reader"
            }
          }
        ],
        "tokens": [
          {
