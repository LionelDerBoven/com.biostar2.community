              "en": "User ID"
            },
            "example": "101"
          },
          {
            "name": "user_group",
            "type": "string",
            "title": {
              "en": "User Group"
            },
            "example": "All Users"
          },
          {
            "name": "email",
            "type": "string",
            "title": {
              "en": "Email"
            },
            "example": "user@example.com"
          },
          {
            "name": "title",
            "type": "string",
            "title": {
              "en": "Title"
            },
            "example": "Staff"
          },
          {
            "name": "department",
            "type": "string",
            "title": {
              "en": "Department"
            },
            "example": "Management"
          },
          {
            "name": "telephone",
            "type": "string",
            "title": {
              "en": "Telephone"
            },
            "example": "+1234567890"
          },
          {
            "name": "login_id",
            "type": "string",
            "title": {
              "en": "Login ID"
            },
            "example": "johndoe"
          },
